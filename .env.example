# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=medicitas
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=medicitas
POSTGRES_PORT=5432

# --- API --------------------------------------------------------------------
API_PORT=8080

# --- Keycloak ---------------------------------------------------------------
# Issuer = host que ve el cliente (localhost). JWKS = nombre DNS interno en Compose.
KC_HTTP_PORT=6767
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar_en_local
KC_REALM=medicitas
KC_ISSUER_URL=http://localhost:6767/realms/medicitas
KC_JWKS_URL=http://keycloak:6767/realms/medicitas/protocol/openid-connect/certs
# Users temporales del realm (hasta el seeder de Elías): plat-admin/plat123, recep-norte/recep123

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379
