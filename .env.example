# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=medicitas
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=medicitas
POSTGRES_PORT=5432

# Rol de la API (NOBYPASSRLS). La contraseña coincide con db/migrations/03_rls.sql.
# Seed y Keycloak siguen usando POSTGRES_USER (superusuario: migraciones y semilla).
APP_DB_USER=medicitas_app
APP_DB_PASSWORD=medicitas_app

# --- API --------------------------------------------------------------------
API_PORT=8080

# --- Keycloak ---------------------------------------------------------------
# Issuer = host que ve el cliente (localhost). JWKS = nombre DNS interno en Compose.
KC_HTTP_PORT=6767
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=cambiar_en_local
KC_REALM=medicitas
KC_ISSUER_URL=http://localhost:6767/realms/medicitas
KC_JWKS_URL=http://keycloak:6767/realms/medicitas/protocol/openid-connect/certs

# --- Usuarios de prueba (demo) ---------------------------------------------
# Documentación del contrato IdP ↔ seeder. Valores de mentira para local/CI.
# Hoy coinciden con id-provider/import/medicitas-realm.json; cuando el seeder
# cree los users por Admin API, leerá estas vars (en prod: secret manager / CI vars).
SEED_USER_PLAT_ADMIN=plat-admin
SEED_PASS_PLAT_ADMIN=plat123
SEED_USER_RECEP_NORTE=recep-norte
SEED_PASS_RECEP_NORTE=recep123
SEED_RECEP_NORTE_CLINICA_ID=clinica-norte
# Users base del realm: plat-admin/plat123, recep-norte/recep123.
# El job de semilla crea el resto y no cambia passwords de users existentes.

# --- Semilla (seed) ---------------------------------------------------------
SEED_VERSION=demo-v1
SEED_USER_PASSWORD=cambiar_en_local

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379
